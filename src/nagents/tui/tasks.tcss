TaskScreen {
    align: center middle;
    background: $ngn-overlay;
}

#task-dialog {
    width: 96;
    max-width: 96%;
    height: 92%;
    min-height: 16;
    padding: 1 2;
    border: round $ngn-accent;
    background: $ngn-panel;
    color: $ngn-text;
}

#task-caption, #task-hint {
    color: $ngn-muted;
    height: auto;
    max-height: 2;
}

#task-body {
    height: 1fr;
    min-height: 5;
    margin: 1 0;
}

#task-options {
    width: 32%;
    min-width: 21;
    height: 1fr;
    border: none;
    border-right: solid $ngn-border;
    background: $ngn-panel;
    color: $ngn-text;
    padding: 0 1 0 0;
}

#task-detail {
    width: 1fr;
    padding-left: 2;
}

#task-heading {
    height: 1;
    color: $ngn-accent;
    text-style: bold;
}

#task-history-scroll {
    height: 1fr;
}

#task-history {
    height: auto;
}

#task-followup {
    height: 3;
    border: tall $ngn-border;
    background: $ngn-background;
    color: $ngn-text;
}

#task-followup:focus {
    border: tall $ngn-accent;
}

TaskScreen .dialog-actions {
    height: 3;
    align-horizontal: right;
}

TaskScreen Button {
    margin-left: 1;
}

TaskScreen.compact #task-caption {
    display: none;
}

TaskScreen.compact #task-dialog {
    padding: 0 1;
}

TaskScreen.compact #task-body {
    margin: 0;
    min-height: 3;
}

TaskScreen .task-dialog--user {
    color: $ngn-success;
    text-style: bold;
}

TaskScreen .task-dialog--assistant {
    color: $ngn-accent;
    text-style: bold;
}

TaskScreen .task-dialog--tool {
    color: $ngn-warning;
    text-style: bold;
}

TaskScreen .task-dialog--status {
    color: $ngn-muted;
}
