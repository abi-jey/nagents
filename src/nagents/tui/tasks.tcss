TaskScreen { background: $ngn-background; }

#task-dialog {
    width: 100%;
    height: 100%;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ngn-text;
}
#task-navigation { height: 3; }
#task-navigation #task-heading { width: 1fr; margin: 1 1 0 1; }
#task-close { min-width: 10; margin: 0; }
#task-compose-area { height: auto; background: $ngn-composer-background; }
#task-history .turn { width: 100%; }
TaskScreen.narrow #task-options { display: none; }

#task-caption, #task-hint {
    color: $ngn-muted;
    height: auto;
    max-height: 2;
}

#task-body {
    height: 1fr;
    min-height: 5;
    margin: 1 0;
}

#task-options {
    width: 30;
    min-width: 21;
    height: 1fr;
    border: none;
    border-right: solid $ngn-border;
    background: $ngn-panel;
    color: $ngn-text;
    padding: 0 1 0 0;
}

#task-detail {
    width: 1fr;
    padding-right: 1;
}

#task-heading {
    height: 1;
    color: $ngn-accent;
    text-style: bold;
}

#task-history-scroll {
    height: 1fr;
}

#task-history {
    height: auto;
}

#task-followup {
    height: 3;
    border: none;
    background: $ngn-composer-background;
    color: $ngn-composer-text;
}

#task-followup:focus {
    border: none;
}

TaskScreen .dialog-actions {
    height: 3;
    align-horizontal: right;
}
TaskScreen #task-caption { width: 1fr; margin-top: 1; }
TaskScreen #task-send { width: 20; }

TaskScreen Button {
    margin-left: 1;
}

TaskScreen.compact #task-caption {
    display: none;
}

TaskScreen.compact #task-dialog {
    padding: 0 1;
}

TaskScreen.compact #task-body {
    margin: 0;
    min-height: 3;
}

TaskScreen .task-dialog--user {
    color: $ngn-success;
    text-style: bold;
}

TaskScreen .task-dialog--assistant {
    color: $ngn-accent;
    text-style: bold;
}

TaskScreen .task-dialog--tool {
    color: $ngn-warning;
    text-style: bold;
}

TaskScreen .task-dialog--status {
    color: $ngn-muted;
}
