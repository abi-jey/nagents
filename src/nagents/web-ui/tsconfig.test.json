{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "outDir": ".test-build"
  },
  "include": [
    "src/app/*.test.ts",
    "src/api/*.ts",
    "src/features/chat/drafts*.ts",
    "src/features/chat/transcript*.ts",
    "src/features/chat/activityLayout.test.ts",
    "src/features/chat/agentLabels.test.ts",
    "src/features/chat/appearance.rendering.test.ts",
    "src/features/chat/delegation*.test.ts",
    "src/features/chat/deliveries*.ts",
    "src/features/chat/inlineDeliveryImages.test.ts",
    "src/features/chat/uploads*.ts",
    "src/features/context/*.ts",
    "src/features/settings/*.ts",
    "src/features/live/*.ts"
  ]
}
