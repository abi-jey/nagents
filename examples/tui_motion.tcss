Screen { background: $ngn-background; color: $ngn-text; layers: base overlay; }
#brand { height: 1; margin: 1 2 0 2; color: $ngn-heading; text-style: bold; }
#designs { height: 3; margin: 0 1; }
Button { min-width: 0; width: auto; height: 3; margin-right: 1; border: none; padding: 0 1; background: $ngn-panel; color: $ngn-muted; }
Button:hover, Button:focus { background: $ngn-hover; color: $ngn-text; text-style: $ngn-focus-style; }
Button.-primary { color: $ngn-accent; text-style: bold; }
#body { height: 1fr; margin: 0 2; padding: 0 1; border-top: solid $ngn-border; scrollbar-size: 1 1; }
.speaker { height: 1; margin-top: 1; color: $ngn-assistant; text-style: bold; }
.sample { height: auto; max-width: 90; margin: 0 0 1 0; }
#activity { height: auto; padding: 0 1 1 1; border-left: solid $ngn-border; margin-top: 1; }
.section-label { height: 1; color: $ngn-muted; margin-bottom: 1; }
#activity > Static { height: auto; }
#main-detail, #child-detail { margin-bottom: 1; }
.main-actor { color: $ngn-assistant; }
.child-actor { color: $ngn-tool; }
.waiting { color: $ngn-warning; }
#events { height: auto; margin-top: 1; padding: 1; border-top: solid $ngn-border; }
#event-lines { height: auto; color: $ngn-muted; }
#state-controls { height: 3; margin: 0 2; }
#state-controls Button { width: 1fr; padding: 0; }
#message { height: 3; border: round $ngn-border; border-title-color: $ngn-muted; margin: 0 2; padding: 0 1; background: $ngn-message-background; color: $ngn-message-muted; }
#below-bar { height: auto; padding: 0 3; }
#footer-states { height: 2; }
#footer-states > Static { width: 1fr; height: 2; text-overflow: ellipsis; text-wrap: nowrap; padding-right: 1; }
.orbit #footer-states { layout: vertical; height: 3; }
.orbit #footer-states > Static { width: 100%; height: 1; }
.pulse #footer-states { height: 3; }
.pulse #footer-states > Static { height: 3; padding: 0 1; border-left: solid $ngn-border; }
#provider-model { height: 1; color: $ngn-muted; text-overflow: ellipsis; text-wrap: nowrap; }
#keys { height: 2; margin: 0 3; color: $ngn-muted; text-overflow: ellipsis; }
#splash { layer: overlay; position: absolute; width: 100%; height: 100%; background: $ngn-background; align: center middle; }
#startup-mark { width: 36; height: 2; content-align: center middle; color: $ngn-assistant; }
#startup-name { width: 36; height: 3; content-align: center middle; text-style: bold; color: $ngn-heading; }
#startup-copy { width: 40; height: 2; content-align: center middle; color: $ngn-muted; }
