{
  "config_version": 1,
  "backend": "nagents",
  "runner": ["python", "-m", "ngn_nagents"],
  "provider": "my-provider",
  "providers": {
    "my-provider": {
      "kind": "openai_compatible",
      "model": "YOUR_MODEL_ID",
      "api": "auto",
      "base_url": "",
      "api_key_env": "OPENAI_API_KEY"
    }
  },
  "read_only": false,
  "max_tool_rounds": 100,
  "shell_timeout_seconds": 120,
  "subagents": {
    "max_depth": 2,
    "max_concurrent": 3,
    "max_executions": 8,
    "timeout_seconds": 300
  }
}
